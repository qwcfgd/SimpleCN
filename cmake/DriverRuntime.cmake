# Application-side vendor API DLLs, not Windows kernel/device drivers.
set(HOST_DRIVER_SOURCE_DIR "${CMAKE_SOURCE_DIR}/driver")
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(HOST_DRIVER_ARCH x64)
else()
    set(HOST_DRIVER_ARCH x86)
endif()
foreach(bus CAN LIN)
    if(bus STREQUAL "CAN")
        set(name PCANBasic.dll)
    else()
        set(name PLinApi.dll)
    endif()
    set(runtime "${HOST_DRIVER_SOURCE_DIR}/peak/${HOST_DRIVER_ARCH}/${name}")
    if(NOT EXISTS "${runtime}")
        set(runtime "${CMAKE_SOURCE_DIR}/resource/dll/${bus}/${HOST_DRIVER_ARCH}/${name}")
    endif()
    if(NOT EXISTS "${runtime}")
        message(FATAL_ERROR "Missing ${HOST_DRIVER_ARCH} PEAK runtime: ${name}")
    endif()
    list(APPEND HOST_PEAK_RUNTIME_FILES "${runtime}")
endforeach()
foreach(spec "tosun/libTSCAN.dll" "tosun/libTSH.dll" "vector/vxlapi64.dll")
    # Vector calls its 32-bit DLL vxlapi.dll.
    if(HOST_DRIVER_ARCH STREQUAL "x86")
        string(REPLACE "vxlapi64.dll" "vxlapi.dll" spec "${spec}")
    endif()
    string(REPLACE "/" ";" parts "${spec}")
    list(GET parts 0 vendor)
    list(GET parts 1 dll)
    if(NOT EXISTS "${HOST_DRIVER_SOURCE_DIR}/${vendor}/${HOST_DRIVER_ARCH}/${dll}")
        message(WARNING "Optional hardware runtime missing: driver/${vendor}/${HOST_DRIVER_ARCH}/${dll}; that backend cannot run until the official runtime is supplied.")
    endif()
endforeach()
set_property(GLOBAL PROPERTY HOST_DRIVER_SOURCE_DIR "${HOST_DRIVER_SOURCE_DIR}")
function(driver_deploy target)
    # All tests share one destination. One always-run dependency per directory
    # avoids parallel copies, and refreshes DLL-only changes without relinking.
    get_target_property(output_dir ${target} RUNTIME_OUTPUT_DIRECTORY)
    if(NOT output_dir)
        get_target_property(output_dir ${target} BINARY_DIR)
    endif()
    if(CMAKE_CONFIGURATION_TYPES AND NOT output_dir MATCHES "\\$<")
        string(APPEND output_dir "/$<CONFIG>")
    endif()
    string(MD5 directory_id "${output_dir}")
    set(deploy_target "driver_runtime_${directory_id}")
    if(NOT TARGET ${deploy_target})
        get_property(driver_source GLOBAL PROPERTY HOST_DRIVER_SOURCE_DIR)
        add_custom_target(${deploy_target}
            COMMAND ${CMAKE_COMMAND} -E make_directory "${output_dir}/driver"
            COMMAND ${CMAKE_COMMAND} -E copy_directory "${driver_source}" "${output_dir}/driver"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${output_dir}/driver/peak/${HOST_DRIVER_ARCH}"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different ${HOST_PEAK_RUNTIME_FILES} "${output_dir}/driver/peak/${HOST_DRIVER_ARCH}"
            COMMENT "Copying packaged device API runtimes into driver/"
            VERBATIM)
    endif()
    add_dependencies(${target} ${deploy_target})
endfunction()
