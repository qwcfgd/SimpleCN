+    return t_LastLinErr == errOK;
+}
+
+bool tstPeakLin::signalRequestFrameBoundary()
+{
+    if (!t_open || !t_signalFirstSlot) { t_LastLinErr = errIllegalSchedule; return false; }
+    BYTE state = schNotRunning;
+    t_LastLinErr = t_pPLinApi->GetHardwareParam(t_hHw, hwpScheduleState, &state, sizeof(state));
+    if (t_LastLinErr != errOK) return false;
+    if (state == schSuspended) return true;
+    if (state != schRunning) { t_LastLinErr = errIllegalSchedulerState; return false; }
+    t_LastLinErr = t_pPLinApi->SuspendSchedule(t_hClient, t_hHw);
+    return t_LastLinErr == errOK;
+}
+
+bool tstPeakLin::signalFrameBoundaryReached(bool &reached)
+{
+    reached = false;
+    if (!t_open || !t_signalFirstSlot) { t_LastLinErr = errIllegalSchedule; return false; }
+    BYTE state = schNotRunning;
+    t_LastLinErr = t_pPLinApi->GetHardwareParam(t_hHw, hwpScheduleState, &state, sizeof(state));
+    if (t_LastLinErr != errOK) return false;
+    if (state == schRunning) return true;
+    if (state != schSuspended) { t_LastLinErr = errIllegalSchedulerState; return false; }
+    reached = true;
+    t_LastLinErr = t_pPLinApi->SetScheduleBreakPoint(t_hClient, t_hHw, 0, 0);
     return t_LastLinErr == errOK;
 }
 
